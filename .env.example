# ============================================================
# myagentclaw — Environment Variables
# Copy file ini ke .env lalu isi semua nilai nyata
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=myagentclaw
POSTGRES_USER=myagentclaw_user
POSTGRES_PASSWORD=your_strong_password_here

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_min_32_chars_here_change_this
INTERNAL_SECRET_KEY=secret_between_backend_and_openclaw_change_this
OPENCLAW_GATEWAY_TOKEN=shared_openclaw_gateway_token_change_this
OPENCLAW_ADAPTER_CONTROL_TOKEN=shared_adapter_control_token_change_this
MYAGENTCLAW_DEDICATED_GATEWAY_TOKEN_SECRET=dedicated_gateway_token_master_secret_change_this
MYAGENTCLAW_DEDICATED_ADAPTER_CONTROL_TOKEN_SECRET=dedicated_adapter_control_master_secret_change_this
# Gunakan master key khusus untuk credential Polymarket. Disarankan base64 dari 32 random bytes.
POLYMARKET_CREDENTIALS_ENCRYPTION_KEY=replace_with_base64_32_byte_random_key
# Opsional saat rotasi/migrasi key lama. Hanya dipakai untuk decrypt ciphertext lama lalu re-encrypt dengan key utama.
POLYMARKET_CREDENTIALS_LEGACY_DECRYPTION_KEY=
POLYMARKET_CREDENTIALS_ENCRYPTION_KEY_ID=local-dev-v1
POLYMARKET_AUTOPILOT_LIVE_EXECUTION_ENABLED=true
FRONTEND_URL=http://localhost:3000

# ── Google Auth ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com

# ── AI Provider (OpenAI Codex OAuth default) ────────────────
OPENAI_OAUTH_TOKEN=
OPENAI_MODEL=openai-codex/gpt-5.4
OPENAI_BASE_URL=
# OPENAI_API_KEY=
OPENAI_TEMPERATURE=
OPENAI_TOP_P=
OPENAI_MAX_TOKENS=
OPENAI_STREAM=true
OPENAI_REASONING=none
# OPENAI_IMAGE_MODEL=

# ── Channel: Telegram ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# ── Payment: Xendit ──────────────────────────────────────────
XENDIT_SECRET_KEY=xnd_...
XENDIT_WEBHOOK_TOKEN=your_xendit_webhook_verification_token

# ── Frontend (Next.js public env) ────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_WS_URL=http://localhost:3001
