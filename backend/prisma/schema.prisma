// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum SubTier {
  FREE
  STARTER
  GROWTH
  PRO
}

enum SubStatus {
  ACTIVE
  GRACE
  SUSPENDED
  EXPIRED
}

enum AgentStatus {
  ACTIVE
  INACTIVE
}

enum AgentAccessMode {
  OPEN_ACCESS
  APPROVAL_REQUIRED
}

enum ChannelType {
  TELEGRAM
  WHATSAPP
}

enum ChannelStatus {
  CONNECTED
  DISCONNECTED
  CONNECTING
}

enum KnowledgeType {
  FAQ
  PRODUCT
  INFO
  PAYMENT
  SCHEDULE
}

enum LeadStatus {
  NEW
  PROSPECT
  WARM
  HOT
  CLOSED
  LOST
}

enum ConversationStatus {
  ACTIVE
  NEEDS_ADMIN
  CLOSED
}

enum MessageRole {
  CUSTOMER
  AI
  ADMIN
}

enum AgentCustomerAccessStatus {
  PENDING
  ACTIVE
}

enum FollowUpType {
  FOLLOW_UP
  PAYMENT_REMINDER
  REACTIVATION
}

enum FollowUpStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum PaymentReminderType {
  INVOICE
  DP
  INSTALLMENT
  SUBSCRIPTION
}

enum PaymentReminderStatus {
  PENDING
  SCHEDULED
  SENT
  FAILED
  CANCELLED
}

enum AppointmentScheduleStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULED
  MISSED
}

enum AppointmentType {
  SALES_CALL
  DEMO
  CONSULTATION
  SUPPORT
  FOLLOW_UP
  CUSTOM
}

enum AppointmentLocationType {
  ONLINE
  OFFLINE
  PHONE_CALL
}

enum CrmPipelinePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CrmPipelineActivityType {
  CREATED
  STAGE_CHANGED
  NOTE_ADDED
  APPOINTMENT_CREATED
  APPOINTMENT_COMPLETED
  PAYMENT_SENT
  PAYMENT_COMPLETED
  LOST
  WON
  ASSIGNED_AGENT_CHANGED
  LEAD_ARCHIVED
  LEAD_RESTORED
  LEAD_DELETED
}

enum SubscriptionStatus {
  ACTIVE
  GRACE
  SUSPENDED
  EXPIRED
}

enum TransactionType {
  SUBSCRIPTION
  TOPUP
  ADDON
}

enum TransactionStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum AddOnStatus {
  ACTIVE
  EXPIRED
}

enum PolymarketTradeAuditAction {
  PREVIEW
  PLACE_ORDER
  CANCEL_ORDER
}

enum PolymarketTradeAuditStatus {
  SUCCESS
  FAILED
  REJECTED
}

enum PolymarketAutopilotStatus {
  DRAFT
  READY
  ACTIVE
  PAUSED
  STOPPING
  EMERGENCY_STOP
  ERROR
}

enum PolymarketAutopilotRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  COMPLETED_NO_ACTION
  BLOCKED_BY_GUARDRAIL
  FAILED
  CANCELLED
}

enum PolymarketAutopilotDecisionType {
  PLACE_ORDER
  CANCEL_ORDER
  SKIP
}

enum PolymarketAutopilotDecisionStatus {
  PROPOSED
  BLOCKED
  EXECUTED
  SKIPPED
  FAILED
  CANCELLED
}

enum PolymarketAutopilotAlertSeverity {
  WARNING
  CRITICAL
}

enum PolymarketAutopilotAlertStatus {
  OPEN
  RESOLVED
}

// ─────────────────────────────────────────────
// PART 1: CORE TABLES
// ─────────────────────────────────────────────

model Owner {
  id            String      @id @default(cuid())
  name          String
  email         String      @unique
  passwordHash  String      @map("password_hash")
  phone         String?
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  workspaces    Workspace[]
  crmPipelineActivitiesAuthored CrmPipelineActivity[] @relation("CrmActivityCreatedByUser")
  crmPipelineNotesAuthored      CrmPipelineNote[]     @relation("CrmNoteCreatedByUser")

  @@map("owners")
}

model Workspace {
  id            String      @id @default(cuid())
  ownerId       String      @map("owner_id")
  name          String
  businessType  String      @map("business_type")
  subTier       SubTier     @default(FREE) @map("sub_tier")
  subStatus     SubStatus   @default(ACTIVE) @map("sub_status")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  owner         Owner       @relation(fields: [ownerId], references: [id])
  agents        Agent[]
  agentCustomerAccesses AgentCustomerAccess[]
  channels      Channel[]
  customers     Customer[]
  subscriptions Subscription[]
  quotaUsages   QuotaUsage[]
  transactions  Transaction[]
  addOns        AddOn[]
  adminUsers    AdminUser[]
  knowledgeBases KnowledgeBase[]
  polymarketProfile PolymarketProfile?
  polymarketTradeAudits PolymarketTradeAudit[]
  polymarketAutopilotConfig PolymarketAutopilotConfig?
  polymarketAutopilotRuns PolymarketAutopilotRun[]
  polymarketAutopilotDecisions PolymarketAutopilotDecision[]
  polymarketAutopilotHealthChecks PolymarketAutopilotHealthCheck[]
  polymarketAutopilotAlerts PolymarketAutopilotAlert[]
  paymentReminders PaymentReminder[]
  appointmentSchedules AppointmentSchedule[]
  appointmentAvailabilities AppointmentAvailability[]
  appointmentActivityLogs AppointmentActivityLog[]
  crmPipelines CrmPipeline[]
  crmCustomerPipelineEntries CrmCustomerPipelineEntry[]
  crmPipelineActivities CrmPipelineActivity[]
  crmPipelineNotes CrmPipelineNote[]

  @@map("workspaces")
}

model PolymarketProfile {
  id              String    @id @default(cuid())
  workspaceId     String    @unique @map("workspace_id")
  accountAddress  String?   @map("account_address")
  apiAddress      String?   @map("api_address")
  funderAddress   String?   @map("funder_address")
  signatureType   Int?      @map("signature_type")
  signerAddress   String?   @map("signer_address")
  encryptedPrivateKey String? @map("encrypted_private_key")
  encryptedApiKey String?   @map("encrypted_api_key")
  encryptedApiSecret String? @map("encrypted_api_secret")
  encryptedApiPassphrase String? @map("encrypted_api_passphrase")
  credentialsLastVerifiedAt DateTime? @map("credentials_last_verified_at")
  credentialsLastError String? @map("credentials_last_error")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  workspace       Workspace @relation(fields: [workspaceId], references: [id])

  @@map("polymarket_profiles")
}

model PolymarketTradeAudit {
  id               String                    @id @default(cuid())
  workspaceId      String                    @map("workspace_id")
  ownerId          String                    @map("owner_id")
  source           String                    @default("MANUAL")
  action           PolymarketTradeAuditAction
  status           PolymarketTradeAuditStatus
  marketSlug       String?                   @map("market_slug")
  marketQuestion   String?                   @map("market_question")
  tokenId          String?                   @map("token_id")
  outcomeLabel     String?                   @map("outcome_label")
  side             String?
  orderKind        String?                   @map("order_kind")
  orderType        String?                   @map("order_type")
  price            Decimal?                  @db.Decimal(18, 8)
  size             Decimal?                  @db.Decimal(18, 8)
  amount           Decimal?                  @db.Decimal(18, 8)
  approvalRequired Boolean                   @default(false) @map("approval_required")
  responseOrderId  String?                   @map("response_order_id")
  runId            String?                   @map("run_id")
  decisionId       String?                   @map("decision_id")
  reasonCode       String?                   @map("reason_code")
  requestJson      Json?                     @map("request_json")
  responseJson     Json?                     @map("response_json")
  errorMessage     String?                   @map("error_message")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")

  workspace        Workspace                 @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([workspaceId, action, status])
  @@map("polymarket_trade_audits")
}

model PolymarketAutopilotConfig {
  id                  String                    @id @default(cuid())
  workspaceId         String                    @unique @map("workspace_id")
  ownerId             String                    @map("owner_id")
  status              PolymarketAutopilotStatus @default(DRAFT)
  strategyType        String                    @map("strategy_type")
  strategyConfigJson  Json                      @map("strategy_config_json")
  riskConfigJson      Json                      @map("risk_config_json")
  marketScopeJson     Json                      @map("market_scope_json")
  executionConfigJson Json                      @map("execution_config_json")
  lastValidatedAt     DateTime?                 @map("last_validated_at")
  lastValidationError String?                   @map("last_validation_error")
  lastRunAt           DateTime?                 @map("last_run_at")
  pausedReason        String?                   @map("paused_reason")
  emergencyStoppedAt  DateTime?                 @map("emergency_stopped_at")
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")

  workspace           Workspace                 @relation(fields: [workspaceId], references: [id])
  runs                PolymarketAutopilotRun[]
  decisions           PolymarketAutopilotDecision[]
  healthChecks        PolymarketAutopilotHealthCheck[]
  alerts              PolymarketAutopilotAlert[]

  @@index([ownerId, status])
  @@map("polymarket_autopilot_configs")
}

model PolymarketAutopilotRun {
  id            String                       @id @default(cuid())
  workspaceId   String                       @map("workspace_id")
  configId      String?                      @map("config_id")
  status        PolymarketAutopilotRunStatus
  startedAt     DateTime                     @default(now()) @map("started_at")
  finishedAt    DateTime?                    @map("finished_at")
  snapshotJson  Json?                        @map("snapshot_json")
  summaryJson   Json?                        @map("summary_json")
  errorMessage  String?                      @map("error_message")
  createdAt     DateTime                     @default(now()) @map("created_at")
  updatedAt     DateTime                     @updatedAt @map("updated_at")

  workspace     Workspace                    @relation(fields: [workspaceId], references: [id])
  config        PolymarketAutopilotConfig?   @relation(fields: [configId], references: [id])
  decisions     PolymarketAutopilotDecision[]

  @@index([workspaceId, createdAt])
  @@index([configId, startedAt])
  @@map("polymarket_autopilot_runs")
}

model PolymarketAutopilotDecision {
  id                  String                            @id @default(cuid())
  runId               String?                           @map("run_id")
  configId            String?                           @map("config_id")
  workspaceId         String                            @map("workspace_id")
  decisionType        PolymarketAutopilotDecisionType   @map("decision_type")
  status              PolymarketAutopilotDecisionStatus
  marketSlug          String?                           @map("market_slug")
  tokenId             String?                           @map("token_id")
  side                String?
  payloadJson         Json?                             @map("payload_json")
  guardrailResultJson Json?                             @map("guardrail_result_json")
  reasonCode          String?                           @map("reason_code")
  executedAuditId     String?                           @map("executed_audit_id")
  createdAt           DateTime                          @default(now()) @map("created_at")
  updatedAt           DateTime                          @updatedAt @map("updated_at")

  workspace           Workspace                         @relation(fields: [workspaceId], references: [id])
  run                 PolymarketAutopilotRun?           @relation(fields: [runId], references: [id])
  config              PolymarketAutopilotConfig?        @relation(fields: [configId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([runId, createdAt])
  @@index([workspaceId, status, decisionType])
  @@map("polymarket_autopilot_decisions")
}

model PolymarketAutopilotHealthCheck {
  id                  String                    @id @default(cuid())
  workspaceId         String                    @map("workspace_id")
  configId            String?                   @map("config_id")
  trigger             String
  recommendedAction   String                    @map("recommended_action")
  emergencyStopApplied Boolean                  @default(false) @map("emergency_stop_applied")
  reportJson          Json                      @map("report_json")
  checkedAt           DateTime                  @default(now()) @map("checked_at")
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")

  workspace           Workspace                 @relation(fields: [workspaceId], references: [id])
  config              PolymarketAutopilotConfig? @relation(fields: [configId], references: [id])

  @@index([workspaceId, checkedAt])
  @@index([configId, checkedAt])
  @@map("polymarket_autopilot_health_checks")
}

model PolymarketAutopilotAlert {
  id                  String                         @id @default(cuid())
  workspaceId         String                         @map("workspace_id")
  configId            String?                        @map("config_id")
  severity            PolymarketAutopilotAlertSeverity
  status              PolymarketAutopilotAlertStatus @default(OPEN)
  source              String
  code                String
  title               String
  message             String
  detailsJson         Json?                          @map("details_json")
  firstSeenAt         DateTime                       @default(now()) @map("first_seen_at")
  lastSeenAt          DateTime                       @default(now()) @map("last_seen_at")
  resolvedAt          DateTime?                      @map("resolved_at")
  occurrenceCount     Int                            @default(1) @map("occurrence_count")
  createdAt           DateTime                       @default(now()) @map("created_at")
  updatedAt           DateTime                       @updatedAt @map("updated_at")

  workspace           Workspace                      @relation(fields: [workspaceId], references: [id])
  config              PolymarketAutopilotConfig?     @relation(fields: [configId], references: [id])

  @@index([workspaceId, status, severity, lastSeenAt])
  @@index([workspaceId, code, status])
  @@map("polymarket_autopilot_alerts")
}

model Agent {
  id            String      @id @default(cuid())
  workspaceId   String      @map("workspace_id")
  name          String
  persona       String?
  tone          String?
  goal          String?
  llmProvider   String      @default("openai-codex") @map("llm_provider")
  llmModel      String      @default("openai-codex/gpt-5.4") @map("llm_model")
  // openclaw skill name or config reference
  openclawSkill String?     @map("openclaw_skill")
  accessMode    AgentAccessMode @default(OPEN_ACCESS) @map("access_mode")
  approvalCode  String?     @map("approval_code")
  status        AgentStatus @default(ACTIVE)
  configJson    Json?       @map("config_json")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  workspace     Workspace   @relation(fields: [workspaceId], references: [id])
  channels      Channel[]
  conversations Conversation[]
  customerAccesses AgentCustomerAccess[]
  paymentReminders PaymentReminder[]
  appointmentSchedules AppointmentSchedule[]
  appointmentAvailabilities AppointmentAvailability[]
  crmCustomerPipelineEntriesAssigned CrmCustomerPipelineEntry[]

  @@map("agents")
}

model Channel {
  id            String        @id @default(cuid())
  workspaceId   String        @map("workspace_id")
  agentId       String        @map("agent_id")
  type          ChannelType   @default(TELEGRAM)
  phoneNumber   String?       @map("phone_number")
  status        ChannelStatus @default(DISCONNECTED)
  sessionData   Json?         @map("session_data")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  workspace     Workspace     @relation(fields: [workspaceId], references: [id])
  agent         Agent         @relation(fields: [agentId], references: [id])
  conversations Conversation[]

  @@map("channels")
}

model KnowledgeBase {
  id            String        @id @default(cuid())
  workspaceId   String        @map("workspace_id")
  type          KnowledgeType
  title         String
  content       String
  referenceUrl  String?       @map("reference_url")
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  workspace     Workspace     @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, type])
  @@map("knowledge_bases")
}

// ─────────────────────────────────────────────
// PART 2: CUSTOMER & CHAT TABLES
// ─────────────────────────────────────────────

model Customer {
  id                String        @id @default(cuid())
  workspaceId       String        @map("workspace_id")
  phoneNumber       String        @map("phone_number")
  name              String?
  isArchived        Boolean       @default(false) @map("is_archived")
  archivedAt        DateTime?     @map("archived_at")
  isBlocked         Boolean       @default(false) @map("is_blocked")
  blockedAt         DateTime?     @map("blocked_at")
  lastSeen          DateTime?     @map("last_seen")
  totalInteractions Int           @default(0) @map("total_interactions")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  workspace         Workspace     @relation(fields: [workspaceId], references: [id])
  lead              Lead?
  agentAccesses     AgentCustomerAccess[]
  conversations     Conversation[]
  followUps         FollowUp[]
  paymentReminders  PaymentReminder[]
  appointmentSchedules AppointmentSchedule[]
  crmPipelineEntries CrmCustomerPipelineEntry[]

  @@unique([workspaceId, phoneNumber])
  @@index([workspaceId])
  @@index([workspaceId, isArchived, isBlocked])
  @@map("customers")
}

model AgentCustomerAccess {
  id           String                    @id @default(cuid())
  workspaceId  String                    @map("workspace_id")
  agentId      String                    @map("agent_id")
  customerId   String                    @map("customer_id")
  status       AgentCustomerAccessStatus @default(ACTIVE)
  approvedAt   DateTime?                 @map("approved_at")
  approvalCodeMatchedAt DateTime?        @map("approval_code_matched_at")
  lastPendingAt DateTime?                @map("last_pending_at")
  lastMessageAt DateTime?                @map("last_message_at")
  createdAt    DateTime                  @default(now()) @map("created_at")
  updatedAt    DateTime                  @updatedAt @map("updated_at")

  workspace    Workspace                 @relation(fields: [workspaceId], references: [id])
  agent        Agent                     @relation(fields: [agentId], references: [id])
  customer     Customer                  @relation(fields: [customerId], references: [id])

  @@unique([agentId, customerId])
  @@index([workspaceId, status])
  @@index([customerId, status])
  @@map("agent_customer_accesses")
}

model Lead {
  id          String      @id @default(cuid())
  customerId  String      @unique @map("customer_id")
  workspaceId String      @map("workspace_id")
  status      LeadStatus  @default(NEW)
  notes       String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  customer    Customer    @relation(fields: [customerId], references: [id])

  @@index([workspaceId, status])
  @@map("leads")
}

model Conversation {
  id          String              @id @default(cuid())
  customerId  String              @map("customer_id")
  agentId     String              @map("agent_id")
  channelId   String              @map("channel_id")
  status      ConversationStatus  @default(ACTIVE)
  channelType String              @map("channel_type")
  startedAt   DateTime            @default(now()) @map("started_at")
  endedAt     DateTime?           @map("ended_at")
  createdAt   DateTime            @default(now()) @map("created_at")

  customer    Customer            @relation(fields: [customerId], references: [id])
  agent       Agent               @relation(fields: [agentId], references: [id])
  channel     Channel             @relation(fields: [channelId], references: [id])
  messages    Message[]
  paymentReminders PaymentReminder[]

  @@index([customerId, status])
  @@index([agentId])
  @@map("conversations")
}

model Message {
  id              String        @id @default(cuid())
  conversationId  String        @map("conversation_id")
  role            MessageRole
  content         String
  type            String        @default("text")
  sentAt          DateTime      @default(now()) @map("sent_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  conversation    Conversation  @relation(fields: [conversationId], references: [id])

  @@index([conversationId, sentAt])
  @@map("messages")
}

model FollowUp {
  id          String          @id @default(cuid())
  customerId  String          @map("customer_id")
  workspaceId String          @map("workspace_id")
  type        FollowUpType
  message     String          // Pesan yang akan dikirim saat follow-up
  notes       String?         // Catatan internal (tidak dikirim ke pelanggan)
  scheduledAt DateTime        @map("scheduled_at")
  status      FollowUpStatus  @default(PENDING)
  sentAt      DateTime?       @map("sent_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  customer    Customer        @relation(fields: [customerId], references: [id])

  @@index([workspaceId, status, scheduledAt])
  @@map("follow_ups")
}

model PaymentReminder {
  id             String                @id @default(cuid())
  workspaceId    String                @map("workspace_id")
  customerId     String                @map("customer_id")
  agentId        String                @map("agent_id")
  conversationId String?               @map("conversation_id")
  type           PaymentReminderType
  title          String
  description    String?
  amount         Decimal?              @db.Decimal(12, 2)
  currency       String                @default("IDR")
  dueDate        DateTime              @map("due_date")
  scheduledAt    DateTime              @map("scheduled_at")
  sentAt         DateTime?             @map("sent_at")
  failedAt       DateTime?             @map("failed_at")
  status         PaymentReminderStatus @default(PENDING)
  templateType   PaymentReminderType?  @map("template_type")
  messageContent String                @map("message_content")
  lastError      String?               @map("last_error")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  workspace      Workspace             @relation(fields: [workspaceId], references: [id])
  customer       Customer              @relation(fields: [customerId], references: [id])
  agent          Agent                 @relation(fields: [agentId], references: [id])
  conversation   Conversation?         @relation(fields: [conversationId], references: [id])

  @@index([workspaceId, status, scheduledAt])
  @@index([workspaceId, dueDate])
  @@index([workspaceId, customerId])
  @@index([workspaceId, agentId])
  @@index([conversationId])
  @@map("payment_reminders")
}

model AppointmentSchedule {
  id               String                    @id @default(cuid())
  workspaceId      String                    @map("workspace_id")
  agentId          String                    @map("agent_id")
  customerId       String                    @map("customer_id")
  title            String
  description      String?
  appointmentType  AppointmentType           @map("appointment_type")
  status           AppointmentScheduleStatus @default(PENDING)
  scheduledAt      DateTime                  @map("scheduled_at")
  endAt            DateTime                  @map("end_at")
  timezone         String
  locationType     AppointmentLocationType   @map("location_type")
  meetingLink      String?                   @map("meeting_link")
  physicalLocation String?                   @map("physical_location")
  notes            String?
  reminder24hSent  Boolean                   @default(false) @map("reminder_24h_sent")
  reminder1hSent   Boolean                   @default(false) @map("reminder_1h_sent")
  missedFollowUpSent Boolean                 @default(false) @map("missed_follow_up_sent")
  missedFollowUpSentAt DateTime?            @map("missed_follow_up_sent_at")
  missedFollowUpLockedAt DateTime?          @map("missed_follow_up_locked_at")
  cancelledAt      DateTime?                 @map("cancelled_at")
  completedAt      DateTime?                 @map("completed_at")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")

  workspace        Workspace                 @relation(fields: [workspaceId], references: [id])
  agent            Agent                     @relation(fields: [agentId], references: [id])
  customer         Customer                  @relation(fields: [customerId], references: [id])
  activityLogs     AppointmentActivityLog[]

  @@index([workspaceId])
  @@index([agentId])
  @@index([customerId])
  @@index([scheduledAt])
  @@index([status])
  @@map("appointment_schedules")
}

model AppointmentAvailability {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  agentId     String    @map("agent_id")
  dayOfWeek   Int       @map("day_of_week")
  startHour   String    @map("start_hour")
  endHour     String    @map("end_hour")
  timezone    String
  isEnabled   Boolean   @default(true) @map("is_enabled")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  agent       Agent     @relation(fields: [agentId], references: [id])

  @@index([workspaceId])
  @@index([agentId])
  @@index([dayOfWeek])
  @@index([workspaceId, agentId, dayOfWeek])
  @@map("appointment_availability")
}

model AppointmentActivityLog {
  id             String                    @id @default(cuid())
  workspaceId    String                    @map("workspace_id")
  appointmentId  String                    @map("appointment_id")
  actionType     String                    @map("action_type")
  actionBy       String                    @map("action_by")
  previousStatus AppointmentScheduleStatus? @map("previous_status")
  newStatus      AppointmentScheduleStatus? @map("new_status")
  notes          String?
  createdAt      DateTime                  @default(now()) @map("created_at")

  workspace      Workspace                 @relation(fields: [workspaceId], references: [id])
  appointment    AppointmentSchedule       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([appointmentId])
  @@index([actionType])
  @@index([createdAt])
  @@index([workspaceId, appointmentId, createdAt])
  @@map("appointment_activity_logs")
}

model CrmPipeline {
  id          String                     @id @default(cuid())
  workspaceId String                     @map("workspace_id")
  name        String
  description String?
  color       String                     @default("#2563eb")
  isDefault   Boolean                    @default(false) @map("is_default")
  isActive    Boolean                    @default(true) @map("is_active")
  createdAt   DateTime                   @default(now()) @map("created_at")
  updatedAt   DateTime                   @updatedAt @map("updated_at")

  workspace    Workspace                 @relation(fields: [workspaceId], references: [id])
  stages       CrmPipelineStage[]
  entries      CrmCustomerPipelineEntry[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([workspaceId, isActive])
  @@index([workspaceId, isDefault])
  @@map("crm_pipelines")
}

model CrmPipelineStage {
  id                 String                     @id @default(cuid())
  pipelineId         String                     @map("pipeline_id")
  name               String
  description        String?
  color              String?
  position           Int
  probabilityPercent Int                        @default(0) @map("probability_percent")
  isDefault          Boolean                    @default(false) @map("is_default")
  isClosedWon        Boolean                    @default(false) @map("is_closed_won")
  isClosedLost       Boolean                    @default(false) @map("is_closed_lost")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")

  pipeline            CrmPipeline               @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  entries             CrmCustomerPipelineEntry[]
  previousActivities  CrmPipelineActivity[]     @relation("CrmActivityPreviousStage")
  newActivities       CrmPipelineActivity[]     @relation("CrmActivityNewStage")

  @@unique([pipelineId, position])
  @@index([pipelineId])
  @@index([pipelineId, position])
  @@map("crm_pipeline_stages")
}

model CrmCustomerPipelineEntry {
  id                String                    @id @default(cuid())
  workspaceId       String                    @map("workspace_id")
  customerId        String                    @map("customer_id")
  pipelineId        String                    @map("pipeline_id")
  stageId           String                    @map("stage_id")
  assignedAgentId   String?                   @map("assigned_agent_id")
  title             String
  valueAmount       Decimal?                  @map("value_amount") @db.Decimal(12, 2)
  currency          String                    @default("IDR")
  priority          CrmPipelinePriority       @default(MEDIUM)
  expectedCloseDate DateTime?                 @map("expected_close_date")
  lastActivityAt    DateTime?                 @map("last_activity_at")
  source            String?
  lostReason        String?                   @map("lost_reason")
  notes             String?
  isArchived        Boolean                   @default(false) @map("is_archived")
  archivedAt        DateTime?                 @map("archived_at")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  workspace         Workspace                 @relation(fields: [workspaceId], references: [id])
  customer          Customer                  @relation(fields: [customerId], references: [id])
  pipeline          CrmPipeline               @relation(fields: [pipelineId], references: [id])
  stage             CrmPipelineStage          @relation(fields: [stageId], references: [id])
  assignedAgent     Agent?                    @relation(fields: [assignedAgentId], references: [id], onDelete: SetNull)
  activities        CrmPipelineActivity[]
  pipelineNotes     CrmPipelineNote[]

  @@index([workspaceId])
  @@index([customerId])
  @@index([stageId])
  @@index([assignedAgentId])
  @@index([lastActivityAt])
  @@index([expectedCloseDate])
  @@index([workspaceId, pipelineId, isArchived])
  @@index([workspaceId, stageId, isArchived])
  @@index([workspaceId, customerId])
  @@map("crm_customer_pipeline_entries")
}

model CrmPipelineActivity {
  id                    String                  @id @default(cuid())
  workspaceId           String                  @map("workspace_id")
  customerPipelineEntryId String                @map("customer_pipeline_entry_id")
  type                  CrmPipelineActivityType
  previousStageId       String?                 @map("previous_stage_id")
  newStageId            String?                 @map("new_stage_id")
  note                  String?
  metadataJson          Json?                   @map("metadata_json")
  createdByUserId       String?                 @map("created_by_user_id")
  createdAt             DateTime                @default(now()) @map("created_at")

  workspace             Workspace               @relation(fields: [workspaceId], references: [id])
  customerPipelineEntry CrmCustomerPipelineEntry @relation(fields: [customerPipelineEntryId], references: [id], onDelete: Cascade)
  previousStage         CrmPipelineStage?       @relation("CrmActivityPreviousStage", fields: [previousStageId], references: [id], onDelete: SetNull)
  newStage              CrmPipelineStage?       @relation("CrmActivityNewStage", fields: [newStageId], references: [id], onDelete: SetNull)
  createdByUser         Owner?                  @relation("CrmActivityCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([customerPipelineEntryId])
  @@index([createdAt])
  @@index([workspaceId, customerPipelineEntryId, createdAt])
  @@map("crm_pipeline_activities")
}

model CrmPipelineNote {
  id                    String                   @id @default(cuid())
  workspaceId           String                   @map("workspace_id")
  customerPipelineEntryId String                 @map("customer_pipeline_entry_id")
  content               String
  createdByUserId       String?                  @map("created_by_user_id")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")

  workspace             Workspace                @relation(fields: [workspaceId], references: [id])
  customerPipelineEntry CrmCustomerPipelineEntry @relation(fields: [customerPipelineEntryId], references: [id], onDelete: Cascade)
  createdByUser         Owner?                   @relation("CrmNoteCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([customerPipelineEntryId])
  @@index([workspaceId, customerPipelineEntryId, createdAt])
  @@map("crm_pipeline_notes")
}

// ─────────────────────────────────────────────
// PART 3: BILLING TABLES
// ─────────────────────────────────────────────

model Subscription {
  id            String              @id @default(cuid())
  workspaceId   String              @unique @map("workspace_id")
  tier          SubTier
  status        SubscriptionStatus  @default(ACTIVE)
  quotaLimit    Int                 @map("quota_limit")
  startDate     DateTime            @map("start_date")
  expireDate    DateTime            @map("expire_date")
  autoRenew     Boolean             @default(true) @map("auto_renew")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  workspace     Workspace           @relation(fields: [workspaceId], references: [id])

  @@map("subscriptions")
}

model QuotaUsage {
  id              String    @id @default(cuid())
  workspaceId     String    @map("workspace_id")
  monthYear       String    @map("month_year")  // format: "2026-04"
  usedMessages    Int       @default(0) @map("used_messages")
  limitMessages   Int       @map("limit_messages")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  workspace       Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, monthYear])
  @@index([workspaceId, monthYear])
  @@map("quota_usage")
}

model Transaction {
  id                String            @id @default(cuid())
  workspaceId       String            @map("workspace_id")
  type              TransactionType
  amount            Decimal           @db.Decimal(12, 2)
  status            TransactionStatus @default(PENDING)
  xenditInvoiceId   String?           @map("xendit_invoice_id")
  xenditPaymentId   String?           @map("xendit_payment_id")
  paidAt            DateTime?         @map("paid_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  workspace         Workspace         @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, status])
  @@map("transactions")
}

model AddOn {
  id            String      @id @default(cuid())
  workspaceId   String      @map("workspace_id")
  type          String
  value         Int
  status        AddOnStatus @default(ACTIVE)
  activatedAt   DateTime    @default(now()) @map("activated_at")
  expiresAt     DateTime?   @map("expires_at")
  createdAt     DateTime    @default(now()) @map("created_at")

  workspace     Workspace   @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, status])
  @@map("add_ons")
}

model AdminUser {
  id            String    @id @default(cuid())
  workspaceId   String    @map("workspace_id")
  name          String
  email         String    @unique
  passwordHash  String    @map("password_hash")
  role          String    @default("admin")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  workspace     Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@map("admin_users")
}
